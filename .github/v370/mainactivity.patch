+    private void prepareIntegrityProvider() {
+        if (integrityManager == null || integrityPreparing || integrityTokenProvider != null) return;
+        integrityPreparing = true;
+        integrityManager.prepareIntegrityToken(
+                PrepareIntegrityTokenRequest.builder()
+                        .setCloudProjectNumber(PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER)
+                        .build())
+                .addOnSuccessListener(provider -> {
+                    integrityPreparing = false;
+                    integrityTokenProvider = provider;
+                    if (pendingIntegrityRequestId != null && pendingIntegrityRequestHash != null) {
+                        String requestId = pendingIntegrityRequestId;
+                        String requestHash = pendingIntegrityRequestHash;
+                        pendingIntegrityRequestId = null;
+                        pendingIntegrityRequestHash = null;
+                        requestIntegrityTokenNow(requestHash, requestId);
+                    }
+                })
+                .addOnFailureListener(error -> {
+                    integrityPreparing = false;
+                    integrityTokenProvider = null;
+                    if (pendingIntegrityRequestId != null) {
+                        String requestId = pendingIntegrityRequestId;
+                        pendingIntegrityRequestId = null;
+                        pendingIntegrityRequestHash = null;
+                        sendIntegrityResult(requestId, null, "PROVIDER_PREPARE_FAILED");
+                    }
+                });
+    }
+
+    private void requestIntegrityToken(String requestHash, String requestId) {
+        if (requestId == null || requestId.length() < 8 || requestId.length() > 100 ||
+                requestHash == null || requestHash.length() < 16 || requestHash.length() > 500) {
+            sendIntegrityResult(requestId == null ? "invalid" : requestId, null, "INVALID_REQUEST");
+            return;
+        }
+        runOnUiThread(() -> {
+            if (integrityTokenProvider == null) {
+                pendingIntegrityRequestId = requestId;
+                pendingIntegrityRequestHash = requestHash;
+                prepareIntegrityProvider();
+                return;
+            }
+            requestIntegrityTokenNow(requestHash, requestId);
+        });
+    }
+
+    private void requestIntegrityTokenNow(String requestHash, String requestId) {
+        StandardIntegrityTokenProvider provider = integrityTokenProvider;
+        if (provider == null) {
+            sendIntegrityResult(requestId, null, "PROVIDER_UNAVAILABLE");
+            return;
+        }
+        provider.request(StandardIntegrityTokenRequest.builder().setRequestHash(requestHash).build())
+                .addOnSuccessListener(response -> sendIntegrityResult(requestId, response.token(), null))
+                .addOnFailureListener(error -> {
+                    integrityTokenProvider = null;
+                    prepareIntegrityProvider();
+                    sendIntegrityResult(requestId, null, "TOKEN_REQUEST_FAILED");
+                });
+    }
+
+    private void sendIntegrityResult(String requestId, String token, String error) {
+        runOnUiThread(() -> {
+            if (webView == null) return;
+            String js = "window.PrismNativeHost&&window.PrismNativeHost.integrityToken&&window.PrismNativeHost.integrityToken(" +
+                    JSONObject.quote(requestId == null ? "" : requestId) + "," +
+                    (token == null ? "null" : JSONObject.quote(token)) + "," +
+                    (error == null ? "null" : JSONObject.quote(error)) + ");";
+            webView.evaluateJavascript(js, null);
+        });
+    }
